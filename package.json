{
  "name": "dsh-medical-extract",
  "version": "0.1.0",
  "description": "病历定向抽取：按抽取模板（字段清单）从病历文书里抽取内容，每个值带逐字原文出处；面向千万级文书（分片、并行、断点续跑、模型去重缓存）。DeepSeek Harness 插件。",
  "type": "module",
  "license": "MIT",
  "author": "wld007",
  "engines": {
    "node": ">=22.5",
    "dsh": ">=0.2.1-0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "templates": "node scripts/build-templates.mjs"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "keywords": ["dsh", "deepseek-harness", "cordis", "plugin", "medical", "information-extraction", "chart-abstraction"],
  "files": ["index.js", "client.js", "lib/**/*.js", "templates/*.json", "vendor/xlsx.mjs", "vendor/SheetJS-LICENSE.txt", "cordis.patch.yml", "icon.svg", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-settings"] }
  }
}
