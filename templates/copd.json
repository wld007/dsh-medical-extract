{
  "format": "extract-template/1",
  "id": "copd",
  "name": "慢性阻塞性肺疾病（COPD）",
  "version": "0.1.0",
  "domain": "呼吸",
  "description": "慢阻肺研究与质控常用字段：诊断与 GOLD 分级、ABE 分组、症状与 CAT/mMRC、肺功能、急性加重与住院、呼吸衰竭与通气支持、吸入药物（LAMA/LABA/ICS 及复方）、氧疗与肺康复、疫苗、合并症、暴露因素与血气。",
  "references": [
    {
      "title": "慢性阻塞性肺疾病诊治指南（2021 年修订版），中华结核和呼吸杂志 2021;44(3)"
    },
    {
      "title": "Global Initiative for Chronic Obstructive Lung Disease (GOLD) 2025 Report",
      "url": "https://goldcopd.org/2025-gold-report/"
    },
    {
      "title": "慢性阻塞性肺疾病急性加重诊治中国专家共识（2023 年修订版），国际呼吸杂志 2023;43(2)"
    },
    {
      "title": "古脉 G-MPAS 数据目录：慢阻肺专病（字段范围参考）",
      "url": "https://www.g-mpas.com/data.html"
    }
  ],
  "groups": [
    {
      "id": "A",
      "name": "诊断与分级"
    },
    {
      "id": "B",
      "name": "症状与评估"
    },
    {
      "id": "C",
      "name": "肺功能"
    },
    {
      "id": "D",
      "name": "急性加重与住院"
    },
    {
      "id": "E",
      "name": "吸入与口服药物"
    },
    {
      "id": "F",
      "name": "非药物治疗与预防"
    },
    {
      "id": "G",
      "name": "合并症"
    },
    {
      "id": "H",
      "name": "危险因素"
    },
    {
      "id": "K",
      "name": "血气与检验"
    }
  ],
  "fields": [
    {
      "id": "A1",
      "name": "慢阻肺相关诊断",
      "group": "A",
      "priority": "P0",
      "type": "list",
      "granularity": "encounter",
      "definition": "诊断栏写明的慢阻肺、AECOPD、肺气肿、慢性支气管炎等诊断（原文写法）。",
      "sources": {
        "sections": [
          "诊断",
          "初步诊断",
          "出院诊断",
          "入院诊断",
          "ICD-10 名称",
          "ICD-10"
        ]
      },
      "rules": [
        {
          "id": "dx",
          "regex": "(?<v>[^\\n，,。；;：:]{0,14}(?:慢性阻塞性肺疾病|慢阻肺|COPD|肺气肿|慢性支气管炎|慢性喘息性支气管炎)[^\\n，,。；;：:]{0,16})"
        }
      ],
      "recall": {
        "terms": [
          "慢性阻塞性肺疾病",
          "慢阻肺",
          "COPD",
          "AECOPD",
          "肺气肿",
          "慢性支气管炎"
        ]
      }
    },
    {
      "id": "A1c",
      "name": "ICD-10 编码（J41–J44）",
      "group": "A",
      "priority": "P0",
      "type": "list",
      "granularity": "encounter",
      "definition": "慢性支气管炎、肺气肿、慢阻肺编码。",
      "rules": [
        {
          "id": "icd",
          "regex": "(?<![A-Za-z0-9])(?<v>(?:J4[1-4])(?:\\.\\d{1,3})?)(?![0-9A-Za-z])"
        }
      ],
      "recall": {
        "regex": [
          "(?<![A-Za-z0-9])(?:J4[1-4])(?:\\.\\d{1,3})?(?![0-9A-Za-z])"
        ]
      }
    },
    {
      "id": "A2",
      "name": "GOLD 肺功能分级",
      "group": "A",
      "priority": "P0",
      "type": "enum",
      "granularity": "encounter",
      "pick": "last",
      "definition": "气流受限严重程度 GOLD 1–4 级（或写作轻度／中度／重度／极重度气流受限）。",
      "options": [
        {
          "value": "GOLD 1"
        },
        {
          "value": "GOLD 2"
        },
        {
          "value": "GOLD 3"
        },
        {
          "value": "GOLD 4"
        }
      ],
      "rules": [
        {
          "id": "gold",
          "regex": "GOLD\\s*(?:分级)?\\s*[:：]?\\s*(?<v>Ⅳ|Ⅲ|Ⅱ|Ⅰ|IV|III|II|I|[1-4])\\s*级?",
          "map": {
            "1": "GOLD 1",
            "2": "GOLD 2",
            "3": "GOLD 3",
            "4": "GOLD 4",
            "Ⅰ": "GOLD 1",
            "Ⅱ": "GOLD 2",
            "Ⅲ": "GOLD 3",
            "Ⅳ": "GOLD 4",
            "I": "GOLD 1",
            "II": "GOLD 2",
            "III": "GOLD 3",
            "IV": "GOLD 4",
            "轻度": "GOLD 1",
            "中度": "GOLD 2",
            "重度": "GOLD 3",
            "极重度": "GOLD 4"
          }
        },
        {
          "id": "gold-severity",
          "regex": "(?<v>极重度|重度|中度|轻度)\\s*(?:持续)?气流受限",
          "map": {
            "1": "GOLD 1",
            "2": "GOLD 2",
            "3": "GOLD 3",
            "4": "GOLD 4",
            "Ⅰ": "GOLD 1",
            "Ⅱ": "GOLD 2",
            "Ⅲ": "GOLD 3",
            "Ⅳ": "GOLD 4",
            "I": "GOLD 1",
            "II": "GOLD 2",
            "III": "GOLD 3",
            "IV": "GOLD 4",
            "轻度": "GOLD 1",
            "中度": "GOLD 2",
            "重度": "GOLD 3",
            "极重度": "GOLD 4"
          }
        }
      ]
    },
    {
      "id": "A3",
      "name": "GOLD 综合评估分组",
      "group": "A",
      "priority": "P1",
      "type": "enum",
      "granularity": "encounter",
      "pick": "last",
      "definition": "GOLD 综合评估分组：A、B、E 组（2023 前的 C、D 组照记）。",
      "options": [
        {
          "value": "A组"
        },
        {
          "value": "B组"
        },
        {
          "value": "C组"
        },
        {
          "value": "D组"
        },
        {
          "value": "E组"
        }
      ],
      "rules": [
        {
          "id": "abe",
          "regex": "(?:GOLD\\s*(?:(?:[1-4]|Ⅳ|Ⅲ|Ⅱ|Ⅰ|IV|III|II|I)\\s*级)?\\s*[，,]?|综合评估|评估分组|分组)\\s*(?:分组)?\\s*[:：为]?\\s*(?<v>[ABCDE])\\s*组",
          "map": {
            "A": "A组",
            "B": "B组",
            "C": "C组",
            "D": "D组",
            "E": "E组"
          }
        }
      ]
    },
    {
      "id": "A4",
      "name": "本次急性加重（AECOPD）",
      "group": "A",
      "priority": "P0",
      "type": "presence",
      "definition": "本次就诊为慢阻肺急性加重。",
      "recall": {
        "terms": [
          "AECOPD",
          "慢阻肺急性加重",
          "慢性阻塞性肺疾病急性加重",
