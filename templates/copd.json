      "definition": "6 分钟步行距离（m）的测定值，每次测定一条。",
      "rules": [
        {
          "id": "b7-v",
          "regex": "(?<![A-Za-z0-9])(?:6\\s*分钟步行(?:距离|试验)?|6MWD|6MWT)(?![A-Za-z])[^。；;\\n\\d]{0,24}?(?<v>\\d+(?:\\.\\d+)?)"
