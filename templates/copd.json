    {
      "id": "B5",
      "name": "CAT 评分",
      "group": "B",
      "priority": "P0",
      "type": "score",
      "scale": "CAT 评分",
      "granularity": "timepoint",
      "range": {
        "min": 0,
        "max": 40
      },
      "definition": "CAT 评分总分（每次评定一条）。只取写明的总分，不取条目分、不取参考范围。",
      "rules": [
        {
          "id": "b5-total",
          "regex": "(?:CAT|慢阻肺评估测试)\\s*(?:量表)?\\s*(?:评分|总分|得分|评定|测评|分值|评估)?\\s*(?:结果)?\\s*[:：为是]?\\s*(?<v>\\d{1,3}(?:\\.\\d)?)\\s*分?"
