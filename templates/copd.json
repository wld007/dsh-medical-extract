        ]
      }
    },
    {
      "id": "B6",
      "name": "mMRC 呼吸困难分级",
      "group": "B",
      "priority": "P0",
      "type": "score",
      "scale": "mMRC 呼吸困难分级",
      "granularity": "timepoint",
      "range": {
        "min": 0,
        "max": 4
      },
      "definition": "mMRC 呼吸困难分级总分（每次评定一条）。只取写明的总分，不取条目分、不取参考范围。",
      "rules": [
        {
          "id": "b6-total",
          "regex": "(?:mMRC|改良版?英国医学研究委员会(?:呼吸困难)?(?:问卷|量表)?)\\s*(?:量表)?\\s*(?:评分|总分|得分|评定|测评|分值|评估)?\\s*(?:结果)?\\s*[:：为是]?\\s*(?<v>\\d{1,3}(?:\\.\\d)?)\\s*分?"
