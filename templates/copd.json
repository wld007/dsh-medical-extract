    {
      "id": "C1",
      "name": "FEV1/FVC",
      "group": "C",
      "priority": "P0",
      "type": "number",
      "granularity": "timepoint",
      "unit": "%",
      "range": {
        "min": 10,
        "max": 120
      },
      "definition": "（支气管舒张剂后）FEV1/FVC（%）；写成 0.62 的按 62% 记。",
      "rules": [
        {
          "id": "c1-v",
          "regex": "(?<![A-Za-z0-9])(?:FEV(?:1|₁)\\s*/\\s*FVC|一秒率)(?![A-Za-z])[^。；;\\n\\d]{0,24}?(?<v>[1-9]\\d(?:\\.\\d{1,2})?)"
        },
        {
          "id": "ratio-fraction",
          "regex": "(?:FEV(?:1|₁)\\s*/\\s*FVC|一秒率)[^。；;\\n\\d]{0,12}?(?<v>0\\.\\d{1,3})(?!\\d)",
          "factor": 100
