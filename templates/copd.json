        {
          "value": "Ⅰ型呼吸衰竭",
          "terms": [
            "Ⅰ型呼吸衰竭",
            "I型呼吸衰竭",
            "1型呼吸衰竭",
            "Ⅰ型呼衰",
            "低氧血症性呼吸衰竭"
          ]
        }
      ],
      "granularity": "encounter",
      "pick": "last"
    },
    {
      "id": "A7",
      "name": "慢阻肺诊断时间",
      "group": "A",
      "priority": "P1",
      "type": "date",
      "definition": "首次诊断慢阻肺（或慢性咳嗽咳痰起病）的时间；\"反复咳嗽咳痰20年\"取 20 年前。",
      "granularity": "patient",
      "pick": "earliest",
      "accept": [
        "阳性",
        "既往"
      ],
      "model": "always",
      "sources": {
        "sections": [
          "主诉",
          "现病史",
          "既往史"
        ]
      },
      "recall": {
        "terms": [
          "慢阻肺",
          "慢性阻塞性肺疾病",
          "咳嗽",
          "咳痰",
          "气喘"
        ],
        "regex": [
          "[\\d一二两三四五六七八九十半]+\\s*个?\\s*(?:年|月|周|星期|天|日|小时|h)\\s*(?:余|多|左右|许)?"
        ]
      }
    },
    {
      "id": "A8",
      "name": "病程（月）",
      "group": "A",
      "priority": "P2",
      "type": "derived",
      "definition": "诊断至本次就诊的月数。",
      "derive": {
        "op": "monthsBetween",
        "from": "A7",
        "to": "$encounter.start"
