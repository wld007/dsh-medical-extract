      "rules": [
        {
          "id": "a4-v",
          "regex": "(?<![A-Za-z0-9])(?:eGFR|估算肾小球滤过率|肾小球滤过率)(?![A-Za-z])[^。；;\\n\\d]{0,24}?(?<v>\\d+(?:\\.\\d+)?)"
