      "name": "容量与血压"
    },
    {
      "id": "E",
      "name": "贫血"
    },
    {
      "id": "F",
      "name": "矿物质与骨代谢"
    },
    {
      "id": "G",
      "name": "营养与炎症"
    },
    {
      "id": "H",
      "name": "用药"
    },
    {
      "id": "I",
      "name": "并发症与结局"
    },
    {
      "id": "J",
      "name": "合并症"
    }
