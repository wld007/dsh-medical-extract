{
  "format": "extract-template/1",
  "id": "dlp",
  "name": "血脂异常（DLP）",
  "version": "0.1.0",
  "domain": "心血管",
  "description": "血脂管理与 ASCVD 预防常用字段：血脂异常类型、家族性高胆固醇血症、ASCVD 风险分层与 LDL-C 目标、血脂谱（TC/TG/LDL-C/HDL-C/非 HDL-C/ApoB/Lp(a)）、ASCVD 与危险因素、他汀／依折麦布／PCSK9 抑制剂／英克司兰／贝特类等调脂药物、强度与达标、不良反应（肌病、肝酶、新发糖尿病）与继发因素。",
  "references": [
    {
      "title": "中国血脂管理指南（2023 年），中华心血管病杂志 2023;51(3)"
    },
    {
      "title": "2019 ESC/EAS Guidelines for the management of dyslipidaemias"
    },
    {
      "title": "2018 AHA/ACC Guideline on the Management of Blood Cholesterol"
    },
    {
      "title": "家族性高胆固醇血症筛查与诊治中国专家共识，中华心血管病杂志 2018;46(2)"
    },
    {
      "title": "古脉 G-MPAS 数据目录：血脂异常专病（字段范围参考）",
      "url": "https://www.g-mpas.com/data.html"
    }
  ],
  "groups": [
    {
      "id": "A",
      "name": "诊断与分型"
    },
    {
      "id": "B",
      "name": "风险分层与目标"
    },
    {
      "id": "C",
      "name": "血脂谱"
    },
    {
      "id": "D",
      "name": "ASCVD 与危险因素"
    },
    {
      "id": "E",
      "name": "调脂治疗"
    },
    {
      "id": "F",
      "name": "安全性与继发因素"
    },
    {
      "id": "K",
      "name": "其他检验"
    }
  ],
