          "id": "b4-v",
          "regex": "(?<![A-Za-z0-9])(?:10\\s*年\\s*(?:ASCVD|心血管病?|动脉粥样硬化性心血管疾病)?\\s*(?:发病)?(?:风险|危险))(?![A-Za-z])[^。；;\\n\\d]{0,24}?(?<v>\\d{1,2}(?:\\.\\d{1,2})?(?=\\s*%))"
