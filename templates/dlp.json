          "id": "dx",
          "regex": "(?<v>[^\\n，,。；;：:]{0,14}(?:血脂|高脂血症|高胆固醇|高甘油三酯|脂蛋白)[^\\n，,。；;：:]{0,16})"
        }
      ],
      "recall": {
        "terms": [
