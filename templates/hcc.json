          "regex": "(?<v>[^\\n，,。；;：:]{0,14}(?:肝癌|肝细胞癌|肝细胞肝癌|原发性肝癌|肝恶性肿瘤|HCC|肝内胆管(?:细胞)?癌)[^\\n，,。；;：:]{0,20})"
