{
  "format": "extract-template/1",
  "id": "htn",
  "name": "高血压（HTN）",
  "version": "0.1.0",
  "domain": "心血管",
  "description": "高血压研究与慢病管理常用字段：诊断与分级、心血管风险分层、诊室／动态／家庭血压、危险因素、靶器官损害、临床并存疾病、降压药物（含单片复方）、继发性高血压排查、控制达标与关键检验。",
  "references": [
    {
      "title": "中国高血压防治指南（2024 年修订版），中华高血压杂志 2024;32(7)"
    },
    {
      "title": "2023 ESH Guidelines for the management of arterial hypertension, J Hypertens 2023;41(12)"
    },
    {
      "title": "2024 ESC Guidelines for the management of elevated blood pressure and hypertension"
    },
    {
      "title": "国家基层高血压防治管理指南 2020 版"
    },
    {
      "title": "古脉 G-MPAS 数据目录：高血压专病（字段范围参考）",
      "url": "https://www.g-mpas.com/data.html"
    }
  ],
  "groups": [
    {
      "id": "A",
      "name": "诊断与分级"
    },
    {
      "id": "B",
      "name": "血压测量"
    },
    {
      "id": "C",
      "name": "危险因素"
    },
    {
      "id": "D",
      "name": "靶器官损害"
    },
    {
      "id": "E",
      "name": "临床并存疾病"
    },
    {
      "id": "F",
      "name": "降压治疗"
    },
    {
      "id": "G",
      "name": "继发性高血压与随访"
    },
    {
      "id": "K",
      "name": "检验"
    }
  ],
  "fields": [
    {
      "id": "A1",
      "name": "高血压相关诊断",
      "group": "A",
      "priority": "P0",
      "type": "list",
      "granularity": "encounter",
      "definition": "诊断栏写明的高血压诊断（原文写法，含分级、分层）。",
      "sources": {
        "sections": [
          "诊断",
          "初步诊断",
          "出院诊断",
          "入院诊断",
          "ICD-10 名称",
          "ICD-10"
        ]
      },
      "rules": [
        {
          "id": "dx",
          "regex": "(?<v>[^\\n，,。；;：:]{0,14}(?:高血压)[^\\n，,。；;：:]{0,16})"
        }
      ],
      "recall": {
        "terms": [
          "高血压"
        ]
      }
    },
    {
      "id": "A1c",
      "name": "ICD-10 编码（I10–I15）",
      "group": "A",
      "priority": "P0",
      "type": "list",
      "granularity": "encounter",
      "definition": "高血压编码。",
      "rules": [
        {
          "id": "icd",
          "regex": "(?<![A-Za-z0-9])(?<v>(?:I1[0-5])(?:\\.\\d{1,3})?)(?![0-9A-Za-z])"
        }
      ],
      "recall": {
        "regex": [
          "(?<![A-Za-z0-9])(?:I1[0-5])(?:\\.\\d{1,3})?(?![0-9A-Za-z])"
        ]
      }
    },
    {
      "id": "A2",
      "name": "血压分级",
      "group": "A",
      "priority": "P0",
      "type": "enum",
      "granularity": "encounter",
      "pick": "last",
      "definition": "高血压 1 级、2 级、3 级（按诊断写明的分级）。",
      "options": [
        {
          "value": "1级"
        },
        {
          "value": "2级"
        },
        {
          "value": "3级"
        }
      ],
      "recall": {
        "regex": [
          "高血压(?:病)?\\s*(?:[1-3一二三ⅠⅡⅢ]|I{1,3})\\s*级"
        ]
      },
      "rules": [
        {
          "id": "grade",
          "regex": "高血压(?:病)?\\s*(?<v>Ⅲ|Ⅱ|Ⅰ|III|II|I|[1-3一二三])\\s*级",
          "map": {
            "1": "1级",
            "2": "2级",
            "3": "3级",
            "Ⅰ": "1级",
            "Ⅱ": "2级",
            "Ⅲ": "3级",
