        "min": 3,
        "max": 20
      },
      "definition": "糖化血红蛋白（%）的测定值，每次测定一条。",
      "rules": [
        {
          "id": "b1-v",
          "regex": "(?:HbA1c|HBA1C|糖化血红蛋白|A1C)[^。；;\\n\\d]{0,24}?(?<v>\\d+(?:\\.\\d+)?)"
        }
      ],
      "recall": {
        "regex": [
          "HbA1c|HBA1C|糖化血红蛋白|A1C"
        ]
      }
    },
