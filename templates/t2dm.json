          "血糖控制欠佳",
          "血糖未达标",
          "血糖波动大"
        ]
      },
      "granularity": "encounter"
    },
    {
      "id": "B1",
      "name": "糖化血红蛋白",
      "group": "B",
      "priority": "P0",
      "type": "number",
      "granularity": "timepoint",
      "unit": "%",
