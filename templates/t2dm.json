      "id": "K1",
      "name": "收缩压",
      "group": "K",
      "priority": "P1",
      "type": "number",
      "granularity": "timepoint",
      "unit": "mmHg",
      "range": {
        "min": 60,
        "max": 280
      },
      "definition": "血压记录中的收缩压（每次测量一条）。",
      "rules": [
        {
          "id": "k1-v",
          "regex": "(?:(?:BP|血压)\\s*[:：]?)[^。；;\\n\\d]{0,24}?(?<v>\\d{2,3}(?=\\s*/\\s*\\d{2,3}))"
        }
      ],
      "recall": {
        "regex": [
          "(?:BP|血压)\\s*[:：]?"
        ]
      }
    },
