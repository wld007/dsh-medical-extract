      "granularity": "timepoint",
      "unit": "mmol/L",
      "range": {
        "min": 1,
        "max": 40
      },
      "definition": "空腹血糖（mmol/L）的测定值，每次测定一条。",
      "rules": [
        {
          "id": "b2-v",
          "regex": "(?:空腹血糖|FPG|FBG|空腹葡萄糖|空腹血浆葡萄糖)[^。；;\\n\\d]{0,24}?(?<v>\\d+(?:\\.\\d+)?)"
