    {
      "id": "A3",
      "name": "糖尿病诊断时间",
      "group": "A",
      "priority": "P0",
      "type": "date",
      "definition": "首次诊断糖尿病的时间；\"发现血糖升高10年\"取 10 年前。",
      "granularity": "patient",
      "pick": "earliest",
      "accept": [
        "阳性",
        "既往"
      ],
      "model": "always",
      "sources": {
        "sections": [
          "主诉",
          "现病史",
          "既往史"
        ]
      },
      "recall": {
        "terms": [
          "糖尿病",
          "血糖升高",
          "血糖高",
          "发现血糖"
        ],
        "regex": [
          "[\\d一二两三四五六七八九十半]+\\s*个?\\s*(?:年|月|周|星期|天|日|小时|h)\\s*(?:余|多|左右|许)?"
        ]
      }
    },
