        "sections": [
          "诊断",
          "初步诊断",
          "出院诊断",
          "入院诊断",
          "ICD-10 名称",
          "ICD-10"
        ]
      },
      "rules": [
        {
          "id": "dx",
          "regex": "(?<v>[^\\n，,。；;：:]{0,14}糖尿病[^\\n，,。；;：:]{0,16})"
        }
      ],
      "recall": {
        "terms": [
          "糖尿病"
        ]
      }
    },
    {
