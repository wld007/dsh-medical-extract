{
  "format": "extract-template/1",
  "id": "t2dm",
  "name": "2 型糖尿病（T2DM）",
  "version": "0.1.0",
  "domain": "内分泌",
  "description": "糖尿病研究与质控常用字段：诊断与病程、血糖与代谢指标、慢性并发症（视网膜病变、肾病、神经病变、下肢动脉病变、糖尿病足）、大血管病、急性并发症与低血糖、降糖药物（含 SGLT2i、GLP-1RA、胰岛素）、合并症与危险因素。",
  "references": [
    {
      "title": "中国糖尿病防治指南（2024 版），中华糖尿病杂志 2025;17(1)",
      "url": "https://www.sxcdc.cn/jkfw/jsbz/art/2025/art_a6322e70d224461f900e02e70b2a937c.html"
    },
    {
      "title": "ADA Standards of Care in Diabetes—2025, Diabetes Care 2025;48(Suppl 1)",
      "url": "https://diabetesjournals.org/care/issue/48/Supplement_1"
    },
    {
      "title": "KDIGO 2022 Clinical Practice Guideline for Diabetes Management in CKD"
    }
  ],
  "documents": {
    "excludeRecordTypes": [
      "门诊收费",
      "基本信息"
    ]
  },
  "groups": [
    {
      "id": "A",
      "name": "诊断与病程"
    },
    {
      "id": "B",
      "name": "血糖与代谢"
    },
    {
      "id": "C",
      "name": "微血管并发症"
    },
    {
      "id": "D",
      "name": "大血管与足"
    },
    {
      "id": "E",
      "name": "急性并发症与低血糖"
    },
    {
      "id": "F",
      "name": "降糖治疗"
    },
    {
      "id": "G",
      "name": "心肾保护与合并用药"
    },
    {
      "id": "H",
      "name": "合并症与危险因素"
    },
    {
      "id": "K",
      "name": "其他检验与体征"
    }
  ],
