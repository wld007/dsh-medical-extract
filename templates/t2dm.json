          "id": "b3-v",
          "regex": "(?:餐后\\s*2\\s*(?:小时|h)\\s*血糖|2hPG|2hPBG|OGTT\\s*2\\s*(?:小时|h))[^。；;\\n\\d]{0,24}?(?<v>\\d+(?:\\.\\d+)?)"
